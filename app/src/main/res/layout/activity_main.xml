<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:gravity="center"
    android:padding="32dp">

    <!-- Status Indicator -->
    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="@drawable/card_bg"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <!-- Pulsing circle -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/pulseRing"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/pulse_ring"
                android:alpha="0.3" />

            <View
                android:id="@+id/statusDot"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/status_dot" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvStatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connected"
            android:textColor="@color/green"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvStatusSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Listening for Airtel Bank SMS"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Merchant info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/card_bg"
        android:layout_marginBottom="32dp">

        <TextView
            android:id="@+id/tvMerchantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FamFlow Account"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvLastPing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last sync: connecting..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Sign Out -->
    <Button
        android:id="@+id/btnSignOut"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Sign Out"
        android:backgroundTint="#2A1A2E"
        android:textColor="@color/red"
        android:textStyle="bold"
        android:stateListAnimator="@null" />

</LinearLayout>
